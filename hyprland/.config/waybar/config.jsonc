{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,
  "modules-left": ["group/tags", "custom/layout", "hyprland/window"],
  "modules-center": ["clock"],
  "include": ["~/.config/waybar/host.jsonc"],
  // dwm's bar (dwmbar.sh, fed by hypr/core/tags.lua). Tags: left click views a
  // tag, right click adds it to the view, middle click moves the focused window
  // there. Layout symbol: left/right click cycles forward/back.
  "group/tags": {
    "orientation": "horizontal",
    "modules": ["custom/tag1", "custom/tag2", "custom/tag3", "custom/tag4", "custom/tag5", "custom/tag6", "custom/tag7", "custom/tag8", "custom/tag9"]
  },
  "custom/layout": {
    "exec": "~/.config/waybar/dwmbar.sh layout",
    "signal": 8,
    "escape": true,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh layout next",
    "on-click-right": "~/.config/waybar/dwmbar.sh layout prev"
  },
  "custom/tag1": {
    "exec": "~/.config/waybar/dwmbar.sh tag 1",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh tag 1 view",
    "on-click-right": "~/.config/waybar/dwmbar.sh tag 1 toggleview",
    "on-click-middle": "~/.config/waybar/dwmbar.sh tag 1 tag"
  },
  "custom/tag2": {
    "exec": "~/.config/waybar/dwmbar.sh tag 2",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh tag 2 view",
    "on-click-right": "~/.config/waybar/dwmbar.sh tag 2 toggleview",
    "on-click-middle": "~/.config/waybar/dwmbar.sh tag 2 tag"
  },
  "custom/tag3": {
    "exec": "~/.config/waybar/dwmbar.sh tag 3",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh tag 3 view",
    "on-click-right": "~/.config/waybar/dwmbar.sh tag 3 toggleview",
    "on-click-middle": "~/.config/waybar/dwmbar.sh tag 3 tag"
  },
  "custom/tag4": {
    "exec": "~/.config/waybar/dwmbar.sh tag 4",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh tag 4 view",
    "on-click-right": "~/.config/waybar/dwmbar.sh tag 4 toggleview",
    "on-click-middle": "~/.config/waybar/dwmbar.sh tag 4 tag"
  },
  "custom/tag5": {
    "exec": "~/.config/waybar/dwmbar.sh tag 5",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh tag 5 view",
    "on-click-right": "~/.config/waybar/dwmbar.sh tag 5 toggleview",
    "on-click-middle": "~/.config/waybar/dwmbar.sh tag 5 tag"
  },
  "custom/tag6": {
    "exec": "~/.config/waybar/dwmbar.sh tag 6",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh tag 6 view",
    "on-click-right": "~/.config/waybar/dwmbar.sh tag 6 toggleview",
    "on-click-middle": "~/.config/waybar/dwmbar.sh tag 6 tag"
  },
  "custom/tag7": {
    "exec": "~/.config/waybar/dwmbar.sh tag 7",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh tag 7 view",
    "on-click-right": "~/.config/waybar/dwmbar.sh tag 7 toggleview",
    "on-click-middle": "~/.config/waybar/dwmbar.sh tag 7 tag"
  },
  "custom/tag8": {
    "exec": "~/.config/waybar/dwmbar.sh tag 8",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh tag 8 view",
    "on-click-right": "~/.config/waybar/dwmbar.sh tag 8 toggleview",
    "on-click-middle": "~/.config/waybar/dwmbar.sh tag 8 tag"
  },
  "custom/tag9": {
    "exec": "~/.config/waybar/dwmbar.sh tag 9",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/waybar/dwmbar.sh tag 9 view",
    "on-click-right": "~/.config/waybar/dwmbar.sh tag 9 toggleview",
    "on-click-middle": "~/.config/waybar/dwmbar.sh tag 9 tag"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true
  },
  "cpu": {
    "interval": 5,
    "format": "{usage}% 󰍛",
    "tooltip-format": "CPU: {usage}%\nLoad: {load}",
    "on-click": "$TERM -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "{percentage}% 󰘚",
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
    "on-click": "$TERM -e btop",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  "clock": {
    "format": "{:L%A %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "weeks": "<span color='#7c6f64'>W{}</span>",
        "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "nm-connection-editor"
  },
  // One per WireGuard profile; NM names the interface after the connection.
  // Link state comes over netlink, and the empty disconnected format hides it.
  "network#vpn-home": {
    "interface": "Home",
    "format": "󰣫",
    "format-disconnected": "",
    "tooltip-format": "VPN: {ifname}\n{ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "network#vpn-remote": {
    "interface": "Remote",
    "format": "󱇱",
    "format-disconnected": "",
    "tooltip-format": "VPN: {ifname}\n{ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{capacity}% {icon}",
    "format-charging": "{capacity}% {icon}",
    "format-plugged": "{capacity}% ",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓\n{time} remaining",
    "tooltip-format-charging": "{power:>1.0f}W↑\n{time} to full",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "on-click": "$TERM --class=Wiremix -e wiremix",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Volume: {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    }
  },
  "tray": {
    "icon-size": 12,
    "spacing": 12
  },
  "backlight": {
      "format": "{percent}% {icon}",
      "format-icons": ["󰃞", "󰃟", "󰃠"],
      "tooltip-format": "Brightness: {percent}%"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  }
}
