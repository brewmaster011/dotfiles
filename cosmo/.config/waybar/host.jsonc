{
  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "pulseaudio",
    "bluetooth",
    "network",
    "tray"
  ],
  // k10temp (Ryzen) Tctl - hwmon-path-abs + input-filename because the
  // hwmonN index isn't stable across boots
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "interval": 5,
    "format": "{temperatureC}°C 󰔏",
    "tooltip-format": "CPU (Tctl): {temperatureC}°C"
  }
}
