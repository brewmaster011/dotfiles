;; defsrc is still necessary
(defcfg
  process-unmapped-keys yes
  ;; The Adv360 does its own home row mods in ZMK.
  linux-dev-names-exclude (
    "Adv360 Pro Keyboard"
  )
)

(defsrc
  caps a s d f j k l ;
)
(defvar
  tap-time 150
  hold-time 200
)

(defalias
  ;; f24 is tapped (macro), not held: Hyprland 0.57+ swallows every key
  ;; pressed while a bound key is held, which ate the home row letters.
  escctrl (tap-hold 100 100 esc caps)
  a (multi (macro f24) (tap-hold $tap-time $hold-time a lsft))
  s (multi (macro f24) (tap-hold $tap-time $hold-time s lalt))
  d (multi (macro f24) (tap-hold $tap-time $hold-time d lmet))
  f (multi (macro f24) (tap-hold $tap-time $hold-time f lctl))
  j (multi (macro f24) (tap-hold $tap-time $hold-time j rctl))
  k (multi (macro f24) (tap-hold $tap-time $hold-time k rmet))
  l (multi (macro f24) (tap-hold $tap-time $hold-time l ralt))
  ; (multi (macro f24) (tap-hold $tap-time $hold-time ; rsft))
)

(deflayer base
  @escctrl @a @s @d @f @j @k @l @;
)
